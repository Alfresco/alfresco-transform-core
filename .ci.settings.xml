<settings>
    <mirrors>
        <mirror>
            <id>alfresco-internal</id>
            <name>Alfresco Cloudsmith Internal</name>
            <url>https://artifacts.hyland.dev/basic/alfresco-internal/maven/</url>
            <mirrorOf>*</mirrorOf>
        </mirror>
    </mirrors>

    <servers>
        <!-- Credential for the Cloudsmith mirror (exported by the cloudsmith-auth action) -->
        <server>
            <id>alfresco-internal</id>
            <username>${env.CLOUDSMITH_USERNAME}</username>
            <password>${env.CLOUDSMITH_API_KEY}</password>
        </server>
        <!-- Credential for deploying the artifacts (distributionManagement) -->
        <server>
            <id>alfresco-releases</id>
            <username>${env.CLOUDSMITH_USERNAME}</username>
            <password>${env.CLOUDSMITH_API_KEY}</password>
        </server>

        <!-- private docker registry-->
        <server>
            <id>quay.io</id>
            <username>${env.QUAY_USERNAME}</username>
            <password>${env.QUAY_PASSWORD}</password>
        </server>
        <server>
            <id>docker.io</id>
            <username>${env.DOCKERHUB_USERNAME}</username>
            <password>${env.DOCKERHUB_PASSWORD}</password>
        </server>
    </servers>
</settings>
